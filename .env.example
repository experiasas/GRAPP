# Copia este archivo como .env y ajusta los valores
# cp .env.example .env

# Motor de base de datos: 'postgres' o 'sqlite'
DB_ENGINE=postgres

# --- Usar estos valores cuando corres con Docker Compose ---
DB_NAME=grapp
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db        # En Docker el host es el nombre del servicio, NO localhost
DB_PORT=5432

# --- Usar estos valores cuando corres SIN Docker (local directo) ---
# DB_HOST=localhost

# Django
DEBUG=True
SECRET_KEY=cambia-esta-clave-en-produccion

# Email (en desarrollo el backend de consola imprime los correos en la terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=GRAPP <noreply@grapp.app>

# URL del frontend (usada en correos de activacion)
FRONTEND_URL=http://localhost:5173
