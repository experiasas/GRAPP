# Configuración de Base de Datos
# Valores: 'sqlite' o 'postgres'
DB_ENGINE=sqlite

# Configuración PostgreSQL (solo si DB_ENGINE=postgres)
DB_NAME=grapp_db
DB_USER=grapp_user
DB_PASSWORD=tu_password_seguro_aqui
DB_HOST=localhost
DB_PORT=5432

# -------------------------------------------------------
# Email (en desarrollo el backend de consola está activo por defecto)
# Para producción: configura estas variables y cambia EMAIL_BACKEND
# -------------------------------------------------------
